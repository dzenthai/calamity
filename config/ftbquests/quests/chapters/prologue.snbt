			id: "05EFFA7701C31D75"
			rewards: [
				{
					auto: "enabled"
					id: "6A8A9BD98B4C4AB4"
					item: {
						components: {
							"minecraft:written_book_content": {
								author: "неизвестен"
								pages: [
									{
										raw: "\"...и войне не было ни начала, ни конца. Короли умирали, а знамёна переходили к сыновьям, как долги.\\n\\nНа девятый год реки у Брода стали красными, и никто уже не помнил, за что.\""
									}
									{
										raw: "\"Тогда Хранитель взглянул на поле и сказал:\\n\\n§o«Эта земля запятнана кровью. Agarwaen».§r\\n\\nТак её и зовут с тех пор. Имени Хранителя хроника не сохранила.\""
									}
									{
										raw: "\"§8[дальше страницы выжжены]\""
									}
								]
								resolved: 1b
								title: {
									raw: "Обрывок хроники"
								}
							}
						}
						count: 1
