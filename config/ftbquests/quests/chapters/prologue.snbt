				}
			]
			rewards: [
				{
					id: "57291069A42C8DFC"
					type: "item"
					item: {
						id: "minecraft:written_book"
						count: 1
						components: {
							"minecraft:written_book_content": {
								title: "Письмо без имени"
								author: "Кайрен"
								resolved: true
								pages: [
									"{\"text\": \"Если ты читаешь это — ритуал удался, а я, скорее всего, уже нет.\\n\\nПрости, что вырвал тебя оттуда, где ты был. Здесь тебе понадобятся огонь, сталь и упрямство.\"}"
									"{\"text\": \"Ты не первый, кого мы пытались разбудить. Ты первый, кто проснулся.\\n\\nНочью держись стен. Они придут на твой свет — ты для них как маяк.\"}"
									"{\"text\": \"Найди Аберфорта у Сумеречных врат. Он объяснит больше, чем успел я.\\n\\nИ что бы ни случилось — не верь огню, кото\"}"
								]
							}
						}
					}
					count: 1
					auto: "enabled"
				}
				{
					id: "46C56EF9D4A6895C"
					type: "item"
					item: {
						id: "minecraft:iron_sword"
						count: 1
						components: {
							"minecraft:custom_name": "{\"text\": \"Клинок Кайрена\", \"color\": \"gold\", \"italic\": false}"
							"minecraft:lore": [
								"{\"text\": \"Клинок Хранителя Света.\", \"color\": \"dark_gray\", \"italic\": true}"
								"{\"text\": \"Рукоять стёрта о ладонь, лезвие — нет.\", \"color\": \"dark_gray\", \"italic\": true}"
								"{\"text\": \"Им ни разу не убили человека.\", \"color\": \"dark_gray\", \"italic\": true}"
							]
							"minecraft:damage": 160
						}
