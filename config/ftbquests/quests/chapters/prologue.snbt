						id: "minecraft:written_book"
						count: 1
						components: {
							"minecraft:written_book_content": {
								title: "Обрывок хроники"
								author: "неизвестен"
								resolved: true
								pages: [
									"{\"text\": \"...и войне не было ни начала, ни конца. Короли умирали, а знамёна переходили к сыновьям, как долги.\\n\\nНа девятый год реки у Брода стали красными, и никто уже не помнил, за что.\"}"
									"{\"text\": \"Тогда Хранитель взглянул на поле и сказал:\\n\\n§o«Эта земля запятнана кровью. Agarwaen».§r\\n\\nТак её и зовут с тех пор. Имени Хранителя хроника не сохранила.\"}"
									"{\"text\": \"§8[дальше страницы выжжены]\"}"
								]
							}
						}
					}
					count: 1
					auto: "enabled"
				}
