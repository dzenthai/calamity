				{
					auto: "enabled"
					id: "677D2B770C7898D1"
					item: {
						components: {
							"minecraft:written_book_content": {
								author: "А. Э."
								pages: [
									{
										raw: "\"Кайрен был моим последним учеником. Если ты здесь — значит, он довёл тебя дальше, чем дошёл сам.\\n\\nЗабери эту записку. Возвращайся к вратам, когда будешь готов. Я буду ждать.\""
									}
									{
										raw: "\"§8На обороте, другим почерком, очень мелко:\\n\\n§o«Ты ведь не дочитал последнюю строку? Хорошо.»\""
									}
