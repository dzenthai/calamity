							"minecraft:written_book_content": {
								title: "Записка у врат"
								author: "А. Э."
								resolved: true
								pages: [
									"{\"text\": \"Кайрен был моим последним учеником. Если ты здесь — значит, он довёл тебя дальше, чем дошёл сам.\\n\\nЗабери эту записку. Возвращайся к вратам, когда будешь готов. Я буду ждать.\"}"
									"{\"text\": \"§8На обороте, другим почерком, очень мелко:\\n\\n§o«Ты ведь не дочитал последнюю строку? Хорошо.»\"}"
								]
							}
						}
					}
